+	if (state === "complete") return { disposition: "completed_before_stop", state, processTerminalState: proof.state };
+	if (state === "failed" || state === "rejected") return { disposition: "failed_before_stop", state, processTerminalState: proof.state };
+	return { state, processTerminalState: proof.state };
