+const OWNER_SESSION_STOP_WAIT_MS = 7_000;
+const OWNER_SESSION_STOP_POLL_MS = 100;
+const ACTIVE_ASYNC_STATES = new Set(["queued", "running"]);
+const TERMINAL_ASYNC_STATES = new Set(["complete", "failed", "paused", "stopped", "rejected"]);
+
+type OwnerSessionStopDisposition =
+	| "stopped_observed"
+	| "completed_before_stop"
+	| "failed_before_stop"
+	| "in_process_stopped"
+	| "stop_unverified"
+	| "delivery_failed";
