+type OwnerSessionStopTarget = {
+	runId: string;
+	asyncDir: string;
+	kind: "detached" | "in-process-workflow";
+	previousState: string;
+	controller?: AbortController;
+	delivery?: "delivered" | "controller-aborted" | "failed";
+	deliveryError?: string;
+};
+
+function waitForOwnerStopPoll(delayMs: number): Promise<void> {
+	return new Promise((resolve) => setTimeout(resolve, delayMs));
+}
+
+function classifyOwnerStopTarget(target: OwnerSessionStopTarget): {
+	disposition?: OwnerSessionStopDisposition;
+	state?: string;
+	processTerminalState?: string;
+} {
+	if (target.delivery === "failed") {
+		return { disposition: "delivery_failed" };
+	}
+	const status = readStatus(target.asyncDir);
+	const state = status?.state;
+	if (target.kind === "in-process-workflow") {
+		return state === "stopped"
+			? { disposition: "in_process_stopped", state }
+			: { ...(state ? { state } : {}) };
+	}
