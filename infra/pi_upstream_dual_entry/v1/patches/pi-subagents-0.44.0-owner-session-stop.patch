+/**
+ * Explicit Stop owns the whole child tree. On Windows, signalling only the Pi
+ * writer can orphan an active bash/tool descendant before the writer closes.
+ * taskkill /T must complete before the runner is allowed to write terminal
+ * proof for that writer.
+ */
+export function tryStopChildTree(child: ChildWithKill): boolean {
+	if (process.platform === "win32" && typeof child.pid === "number" && child.pid > 0) {
+		try {
+			const result = spawnSync("taskkill", ["/F", "/T", "/PID", String(child.pid)], {
+				stdio: "ignore",
+				windowsHide: true,
+			});
+			if (result.status === 0) return true;
+		} catch {
+			// Fall through to the ordinary signal path.
+		}
+	}
+	return trySignalChild(child, "SIGTERM");
+}
