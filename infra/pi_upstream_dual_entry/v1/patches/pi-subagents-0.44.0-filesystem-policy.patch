+
+/** Host-side acceptance controls allowed for a read-only restricted child. */
+export function filesystemPolicyAcceptanceError(value: unknown): string | undefined {
+	if (value === undefined || value === false || value === "checked") return undefined;
+	if (!isRecord(value)) return "filesystemPolicy acceptance must be false or a no-command none/checked object.";
+	if (value.verify !== undefined) return "filesystemPolicy cannot use acceptance.verify commands.";
+	if (value.review !== undefined && value.review !== false) return "filesystemPolicy cannot use acceptance.review.";
+	if (value.level !== "none" && value.level !== "checked") return "filesystemPolicy acceptance level must be none or checked.";
+	return undefined;
+}
+
+type Environment = Record<string, string | undefined>;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function sha256(value: string | Buffer): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+
+function normalizeInputSeparators(value: string): string {
+	return process.platform === "win32" ? value.replace(/[\\/]+/g, path.sep) : value;
+}
+
+function comparablePath(value: string): string {
+	const normalized = path.normalize(value).replace(/[\\/]+$/, "");
+	return process.platform === "win32" ? normalized.toLocaleLowerCase("en-US") : normalized;
+}
+
+function samePath(left: string, right: string): boolean {
+	return comparablePath(left) === comparablePath(right);
+}
+
+function pathIsWithin(candidate: string, root: string): boolean {
+	const child = comparablePath(candidate);
+	const parent = comparablePath(root);
+	return child === parent || child.startsWith(`${parent}${path.sep}`);
+}
+
+function containsTraversal(value: string): boolean {
+	return normalizeInputSeparators(value).split(path.sep).some((segment) => segment === "..");
+}
+
+function canonicalExistingPath(value: string, cwd: string, label: string): string {
+	if (typeof value !== "string" || !value.trim()) throw new Error(`${label} must be a non-empty path.`);
+	const trimmed = value.trim();
+	if (containsTraversal(trimmed)) throw new Error(`${label} must not contain '..' traversal segments.`);
+	const platformPath = normalizeInputSeparators(trimmed);
+	const absolute = path.isAbsolute(platformPath) ? path.normalize(platformPath) : path.resolve(cwd, platformPath);
+	try {
+		return path.normalize(fs.realpathSync.native(absolute));
+	} catch (error) {
+		throw new Error(`${label} must resolve to an existing filesystem target: ${error instanceof Error ? error.message : String(error)}`);
+	}
+}
+
+function normalizePathList(value: unknown, cwd: string, label: string, requireNonEmpty: boolean): string[] {
+	if (!Array.isArray(value)) throw new Error(`${label} must be an array of paths.`);
+	if (requireNonEmpty && value.length === 0) throw new Error(`${label} must contain at least one path.`);
+	const resolved = value.map((entry, index) => canonicalExistingPath(entry as string, cwd, `${label}[${index}]`));
+	const unique = new Map<string, string>();
+	for (const entry of resolved) unique.set(comparablePath(entry), entry);
+	return [...unique.values()].sort((left, right) => comparablePath(left).localeCompare(comparablePath(right)));
+}
+
+export function resolveFilesystemPolicy(input: unknown, childCwd: string): ResolvedFilesystemPolicy {
+	if (!isRecord(input)) throw new Error("filesystemPolicy must be an object.");
+	if (input.version === 1) {
+		const resolved = validateResolvedFilesystemPolicy(input);
+		const cwd = canonicalExistingPath(childCwd, process.cwd(), "filesystemPolicy child cwd");
+		if (!samePath(cwd, resolved.cwd)) throw new Error(`filesystemPolicy retained cwd does not match this child cwd: retained=${resolved.cwd} current=${cwd}`);
+		return resolved;
+	}
+	const unknown = Object.keys(input).filter((key) => !["allowedRoots", "deniedPaths", "bash"].includes(key));
+	if (unknown.length > 0) throw new Error(`filesystemPolicy contains unknown field(s): ${unknown.join(", ")}.`);
+	if (input.bash !== undefined && input.bash !== "deny") throw new Error("filesystemPolicy.bash is fixed to 'deny'.");
+	const cwd = canonicalExistingPath(childCwd, process.cwd(), "filesystemPolicy child cwd");
+	if (!fs.statSync(cwd).isDirectory()) throw new Error("filesystemPolicy child cwd must be a directory.");
+	const allowedRoots = normalizePathList(input.allowedRoots, cwd, "filesystemPolicy.allowedRoots", true);
+	for (const [index, root] of allowedRoots.entries()) {
+		if (!fs.statSync(root).isDirectory()) throw new Error(`filesystemPolicy.allowedRoots[${index}] must be a directory.`);
+	}
+	const deniedPaths = normalizePathList(input.deniedPaths ?? [], cwd, "filesystemPolicy.deniedPaths", false);
+	return {
+		version: 1,
+		cwd,
+		allowedRoots,
+		deniedPaths,
+		bash: "deny",
+		allowedTools: FILESYSTEM_POLICY_ALLOWED_TOOLS,
+	};
+}
+
+function validateResolvedFilesystemPolicy(value: unknown): ResolvedFilesystemPolicy {
+	if (!isRecord(value)) throw new Error("filesystem policy payload must be an object.");
+	const exactFields = ["version", "cwd", "allowedRoots", "deniedPaths", "bash", "allowedTools"];
+	const unknown = Object.keys(value).filter((key) => !exactFields.includes(key));
+	if (unknown.length > 0) throw new Error(`filesystem policy payload contains unknown field(s): ${unknown.join(", ")}.`);
+	if (value.version !== 1 || value.bash !== "deny") throw new Error("filesystem policy payload version/bash contract is invalid.");
+	if (typeof value.cwd !== "string" || !path.isAbsolute(normalizeInputSeparators(value.cwd))) throw new Error("filesystem policy payload cwd must be absolute.");
+	if (!Array.isArray(value.allowedRoots) || value.allowedRoots.length === 0 || value.allowedRoots.some((entry) => typeof entry !== "string" || !path.isAbsolute(normalizeInputSeparators(entry)))) {
+		throw new Error("filesystem policy payload allowedRoots must contain absolute paths.");
+	}
+	if (!Array.isArray(value.deniedPaths) || value.deniedPaths.some((entry) => typeof entry !== "string" || !path.isAbsolute(normalizeInputSeparators(entry)))) {
+		throw new Error("filesystem policy payload deniedPaths must contain absolute paths.");
+	}
+	const allowedTools = value.allowedTools;
+	if (!Array.isArray(allowedTools) || allowedTools.length !== FILESYSTEM_POLICY_ALLOWED_TOOLS.length || FILESYSTEM_POLICY_ALLOWED_TOOLS.some((tool, index) => allowedTools[index] !== tool)) {
+		throw new Error("filesystem policy payload allowedTools contract is invalid.");
+	}
+	const policy = value as unknown as ResolvedFilesystemPolicy;
+	for (const [label, entries] of [["cwd", [policy.cwd]], ["allowedRoots", policy.allowedRoots], ["deniedPaths", policy.deniedPaths]] as const) {
+		for (const entry of entries) {
+			let canonical: string;
+			try { canonical = path.normalize(fs.realpathSync.native(entry)); }
+			catch { throw new Error(`filesystem policy payload ${label} target no longer exists: ${entry}`); }
+			if (!samePath(canonical, entry)) throw new Error(`filesystem policy payload ${label} target changed identity: ${entry}`);
+		}
+	}
+	return policy;
+}
+
+export function encodeFilesystemPolicy(policy: ResolvedFilesystemPolicy): { payload: string; digest: string } {
+	const payload = JSON.stringify(policy);
+	return { payload, digest: sha256(payload) };
+}
+
+export function filesystemPolicyDigest(policy: ResolvedFilesystemPolicy): string {
+	return encodeFilesystemPolicy(policy).digest;
+}
+
+export function fileSha256(filePath: string): string {
+	return sha256(fs.readFileSync(filePath));
+}
+
+export function decodeFilesystemPolicyEnvironment(env: Environment, runtimeModulePath?: string, gateModulePath = FILESYSTEM_POLICY_MODULE_PATH): ResolvedFilesystemPolicy | undefined {
+	const required = env[FILESYSTEM_POLICY_REQUIRED_ENV]?.trim();
+	const payload = env[FILESYSTEM_POLICY_ENV]?.trim();
+	const digest = env[FILESYSTEM_POLICY_SHA256_ENV]?.trim().toLowerCase();
+	const declaredRuntimePath = env[FILESYSTEM_POLICY_RUNTIME_PATH_ENV]?.trim();
+	const declaredRuntimeDigest = env[FILESYSTEM_POLICY_RUNTIME_SHA256_ENV]?.trim().toLowerCase();
+	const declaredGatePath = env[FILESYSTEM_POLICY_GATE_PATH_ENV]?.trim();
+	const declaredGateDigest = env[FILESYSTEM_POLICY_GATE_SHA256_ENV]?.trim().toLowerCase();
+	const anyPolicyField = [required, payload, digest, declaredRuntimePath, declaredRuntimeDigest, declaredGatePath, declaredGateDigest].some(Boolean);
+	if (!anyPolicyField) return undefined;
+	if (required !== "1") throw new Error(`Invalid ${FILESYSTEM_POLICY_REQUIRED_ENV}; active policy requires value '1'.`);
+	if (!payload) throw new Error(`Missing ${FILESYSTEM_POLICY_ENV} for required filesystem policy.`);
+	if (!digest || !/^[0-9a-f]{64}$/.test(digest)) throw new Error(`Missing or invalid ${FILESYSTEM_POLICY_SHA256_ENV}.`);
+	if (sha256(payload) !== digest) throw new Error("Filesystem policy payload hash mismatch.");
+	if (!declaredRuntimePath || !declaredRuntimeDigest || !/^[0-9a-f]{64}$/.test(declaredRuntimeDigest)) throw new Error("Filesystem policy runtime identity is missing or invalid.");
+	if (!declaredGatePath || !declaredGateDigest || !/^[0-9a-f]{64}$/.test(declaredGateDigest)) throw new Error("Filesystem policy gate identity is missing or invalid.");
+	if (runtimeModulePath) {
+		const actualRuntimePath = path.normalize(fs.realpathSync.native(runtimeModulePath));
+		const expectedRuntimePath = path.normalize(fs.realpathSync.native(declaredRuntimePath));
+		if (!samePath(actualRuntimePath, expectedRuntimePath)) throw new Error("Filesystem policy forced runtime path mismatch.");
+		if (fileSha256(actualRuntimePath) !== declaredRuntimeDigest) throw new Error("Filesystem policy forced runtime hash mismatch.");
+	}
+	const actualGatePath = path.normalize(fs.realpathSync.native(gateModulePath));
+	const expectedGatePath = path.normalize(fs.realpathSync.native(declaredGatePath));
+	if (!samePath(actualGatePath, expectedGatePath)) throw new Error("Filesystem policy gate module path mismatch.");
+	if (fileSha256(actualGatePath) !== declaredGateDigest) throw new Error("Filesystem policy gate module hash mismatch.");
+	let parsed: unknown;
+	try { parsed = JSON.parse(payload); }
+	catch (error) { throw new Error(`Filesystem policy payload is not valid JSON: ${error instanceof Error ? error.message : String(error)}`); }
+	return validateResolvedFilesystemPolicy(parsed);
+}
+
+export function assertFilesystemPolicyLaunchContract(input: {
+	policy: ResolvedFilesystemPolicy;
+	args: string[];
+	env: Environment;
+	runtimeModulePath: string;
+}): void {
+	const runtimePath = path.normalize(fs.realpathSync.native(input.runtimeModulePath));
+	let found = false;
+	for (let index = 0; index < input.args.length - 1; index++) {
+		if (input.args[index] === "--extension" && samePath(input.args[index + 1]!, runtimePath)) {
+			found = true;
+			break;
+		}
+	}
+	if (!found) throw new Error("Filesystem policy requires the forced subagent prompt runtime extension before provider launch.");
+	const decoded = decodeFilesystemPolicyEnvironment(input.env);
+	if (!decoded || filesystemPolicyDigest(decoded) !== filesystemPolicyDigest(input.policy)) throw new Error("Filesystem policy launch contract does not match the resolved policy.");
+	const declaredRuntimePath = input.env[FILESYSTEM_POLICY_RUNTIME_PATH_ENV];
+	const declaredRuntimeDigest = input.env[FILESYSTEM_POLICY_RUNTIME_SHA256_ENV];
+	if (!declaredRuntimePath || !samePath(declaredRuntimePath, runtimePath) || declaredRuntimeDigest !== fileSha256(runtimePath)) {
+		throw new Error("Filesystem policy launch runtime identity does not match the forced runtime extension.");
+	}
+	const declaredGatePath = input.env[FILESYSTEM_POLICY_GATE_PATH_ENV];
+	const declaredGateDigest = input.env[FILESYSTEM_POLICY_GATE_SHA256_ENV];
+	const gatePath = path.normalize(fs.realpathSync.native(FILESYSTEM_POLICY_MODULE_PATH));
+	if (!declaredGatePath || !samePath(declaredGatePath, gatePath) || declaredGateDigest !== fileSha256(gatePath)) {
+		throw new Error("Filesystem policy launch gate identity does not match the enforced gate module.");
+	}
+}
+
+function unsafePatternValue(value: string): boolean {
+	const normalized = normalizeInputSeparators(value.trim());
+	return containsTraversal(normalized) || path.isAbsolute(normalized) || /^[A-Za-z]:[\\/]/.test(value.trim()) || /^[\\/]{2}/.test(value.trim());
+}
+
+type AllowedFilesystemTool = (typeof FILESYSTEM_POLICY_ALLOWED_TOOLS)[number];
+
+const TOOL_INPUT_SCHEMAS: Record<AllowedFilesystemTool, {
+	requiredStrings: readonly string[];
+	optionalStrings: readonly string[];
+	optionalNumbers: readonly string[];
+	optionalBooleans: readonly string[];
+}> = {
+	read: { requiredStrings: ["path"], optionalStrings: [], optionalNumbers: ["offset", "limit"], optionalBooleans: [] },
+	grep: { requiredStrings: ["pattern"], optionalStrings: ["path", "glob"], optionalNumbers: ["context", "limit"], optionalBooleans: ["ignoreCase", "literal"] },
+	find: { requiredStrings: ["pattern"], optionalStrings: ["path"], optionalNumbers: ["limit"], optionalBooleans: [] },
+	ls: { requiredStrings: [], optionalStrings: ["path"], optionalNumbers: ["limit"], optionalBooleans: [] },
+};
+
+function validateToolInputShape(toolName: AllowedFilesystemTool, input: Record<string, unknown>): string | undefined {
+	const schema = TOOL_INPUT_SCHEMAS[toolName];
+	const allowed = new Set([...schema.requiredStrings, ...schema.optionalStrings, ...schema.optionalNumbers, ...schema.optionalBooleans]);
+	const unknown = Object.keys(input).filter((key) => !allowed.has(key));
+	if (unknown.length > 0) return `unknown argument(s): ${unknown.join(", ")}`;
+	for (const key of schema.requiredStrings) {
+		if (typeof input[key] !== "string") return `${key} must be a string`;
+	}
+	for (const key of schema.optionalStrings) {
+		if (input[key] !== undefined && typeof input[key] !== "string") return `${key} must be a string`;
+	}
+	for (const key of schema.optionalNumbers) {
+		if (input[key] !== undefined && (typeof input[key] !== "number" || !Number.isFinite(input[key]))) return `${key} must be a finite number`;
+	}
+	for (const key of schema.optionalBooleans) {
+		if (input[key] !== undefined && typeof input[key] !== "boolean") return `${key} must be a boolean`;
+	}
+	return undefined;
+}
+
+function pathPatternValues(toolName: string, input: Record<string, unknown>): string[] {
+	const values: string[] = [];
+	// grep.pattern is content regex, find.pattern is a pathname matcher, and ls
+	// has no path-pattern argument. Treating all three alike blocks harmless
+	// content searches without closing an additional filesystem path.
+	const keys = toolName === "grep" ? ["glob"] : toolName === "find" ? ["pattern"] : [];
+	for (const key of keys) {
+		const value = input[key];
+		if (typeof value === "string") values.push(value);
+		else if (Array.isArray(value)) values.push(...value.filter((entry): entry is string => typeof entry === "string"));
+	}
+	return values;
+}
+
+export function evaluateFilesystemPolicyToolCall(policy: ResolvedFilesystemPolicy, toolName: string, rawInput: unknown): FilesystemPolicyToolDecision {
+	if (toolName === "bash") return { allowed: false, reason: "Blocked by task filesystem policy: bash is always denied." };
+	if (!FILESYSTEM_POLICY_ALLOWED_TOOLS.includes(toolName as (typeof FILESYSTEM_POLICY_ALLOWED_TOOLS)[number])) {
+		return { allowed: false, reason: `Blocked by task filesystem policy: tool '${toolName}' is not in the fixed read/grep/find/ls allowlist.` };
+	}
+	if (!isRecord(rawInput)) return { allowed: false, reason: `Blocked by task filesystem policy: '${toolName}' input must be an object.` };
+	const allowedToolName = toolName as AllowedFilesystemTool;
+	const shapeError = validateToolInputShape(allowedToolName, rawInput);
+	if (shapeError) return { allowed: false, reason: `Blocked by task filesystem policy: malformed '${toolName}' input (${shapeError}).` };
+	if (pathPatternValues(toolName, rawInput).some(unsafePatternValue)) {
+		return { allowed: false, reason: `Blocked by task filesystem policy: '${toolName}' glob/pattern may not be absolute or contain traversal.` };
+	}
+	const rawPath = rawInput.path;
+	if (toolName === "read" && (typeof rawPath !== "string" || !rawPath.trim())) {
+		return { allowed: false, reason: "Blocked by task filesystem policy: read requires a non-empty path." };
+	}
+	if (rawPath !== undefined && (typeof rawPath !== "string" || !rawPath.trim())) {
+		return { allowed: false, reason: `Blocked by task filesystem policy: '${toolName}' path must be a non-empty string.` };
+	}
+	const requested = typeof rawPath === "string" ? rawPath.trim() : policy.cwd;
+	if (containsTraversal(requested)) return { allowed: false, reason: "Blocked by task filesystem policy: '..' traversal is not allowed." };
+	const platformPath = normalizeInputSeparators(requested);
+	const lexical = path.isAbsolute(platformPath) ? path.normalize(platformPath) : path.resolve(policy.cwd, platformPath);
+	let target: string;
+	try { target = path.normalize(fs.realpathSync.native(lexical)); }
+	catch { return { allowed: false, reason: "Blocked by task filesystem policy: target must already exist." }; }
+	if (!policy.allowedRoots.some((root) => pathIsWithin(target, root))) {
+		return { allowed: false, reason: "Blocked by task filesystem policy: target is outside allowedRoots.", resolvedPath: target };
+	}
+	if (policy.deniedPaths.some((denied) => pathIsWithin(target, denied))) {
+		return { allowed: false, reason: "Blocked by task filesystem policy: target is within deniedPaths.", resolvedPath: target };
+	}
+	if (toolName !== "read" && policy.deniedPaths.some((denied) => pathIsWithin(denied, target))) {
+		return { allowed: false, reason: "Blocked by task filesystem policy: recursive/search root is an ancestor of a denied subtree.", resolvedPath: target };
+	}
+	return { allowed: true, resolvedPath: target };
+}
+
+export function registerFilesystemPolicyGate(
+	pi: { on: unknown },
+	env: Environment = process.env,
+	runtimeModulePath?: string,
+): ResolvedFilesystemPolicy | undefined {
+	const policy = decodeFilesystemPolicyEnvironment(env, runtimeModulePath);
+	if (!policy) return undefined;
+	const onRuntimeEvent = pi.on as (event: string, handler: (event: { toolName?: string; input?: unknown }) => unknown) => unknown;
+	onRuntimeEvent("tool_call", (event) => {
+		const toolName = typeof event.toolName === "string" ? event.toolName : "tool";
+		const decision = evaluateFilesystemPolicyToolCall(policy, toolName, event.input);
+		return decision.allowed ? undefined : { block: true, reason: decision.reason };
+	});
+	return policy;
+}
