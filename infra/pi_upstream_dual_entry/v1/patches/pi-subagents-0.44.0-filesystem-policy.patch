+export interface ResolvedFilesystemPolicy {
+	version: 1;
+	cwd: string;
+	allowedRoots: string[];
+	deniedPaths: string[];
+	bash: "deny";
+	allowedTools: readonly ["read", "grep", "find", "ls"];
+}
+
+export interface FilesystemPolicyToolDecision {
+	allowed: boolean;
+	reason?: string;
+	resolvedPath?: string;
