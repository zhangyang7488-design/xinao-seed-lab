+export const FILESYSTEM_POLICY_REQUIRED_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY_REQUIRED";
+export const FILESYSTEM_POLICY_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY";
+export const FILESYSTEM_POLICY_SHA256_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY_SHA256";
+export const FILESYSTEM_POLICY_RUNTIME_PATH_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY_RUNTIME_PATH";
+export const FILESYSTEM_POLICY_RUNTIME_SHA256_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY_RUNTIME_SHA256";
+export const FILESYSTEM_POLICY_GATE_PATH_ENV = "PI_SUBAGENT_FILESYSTEM_POLICY_GATE_PATH";
