+			ticket_id TEXT PRIMARY KEY,
+			reservation_id TEXT NOT NULL REFERENCES spawn_reservations(reservation_id),
+			ordinal INTEGER NOT NULL,
+			state TEXT NOT NULL CHECK (state IN ('reserved','claimed','committed','refunded')),
+			launch_key TEXT,
+			created_at INTEGER NOT NULL,
+			updated_at INTEGER NOT NULL,
+			UNIQUE (reservation_id, ordinal)
