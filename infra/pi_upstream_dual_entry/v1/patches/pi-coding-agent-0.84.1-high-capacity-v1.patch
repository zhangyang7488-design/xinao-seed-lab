+	const binding = resolveBindingInput(env, input.binding);
+	await assertCurrentRootBinding({ env, binding });
+	const ids = ticketIdentifiers(input, env);
+	return withLedgerWrite(binding, input.signal, (database) => {
+		validateMetaIdentity(metaRow(database), binding, { allowStopped: false });
+		const row = database.prepare("SELECT * FROM spawn_tickets WHERE ticket_id=? AND reservation_id=?").get(ids.ticketId, ids.reservationId);
+		if (!row) fail("XINAO_PI_CAPACITY_TICKET_UNKNOWN", "Spawn ticket is not present in the durable reservation ledger.");
+		if (row.launch_key !== ids.launchKey) fail("XINAO_PI_CAPACITY_TICKET_REPLAY", "Spawn ticket launch key does not match its durable claim.");
+		if (row.state === "committed") return Object.freeze({ ...ids, state: "committed", idempotent: true });
+		if (row.state !== "claimed") fail("XINAO_PI_CAPACITY_TICKET_STATE", `Spawn ticket cannot commit from state '${row.state}'.`);
+		const now = Date.now();
+		database.prepare("UPDATE spawn_tickets SET state='committed', updated_at=? WHERE ticket_id=?").run(now, ids.ticketId);
+		database.prepare("UPDATE capacity_meta SET spawn_count=spawn_count+1, updated_at=? WHERE singleton=1").run(now);
+		return Object.freeze({ ...ids, state: "committed", idempotent: false });
+	});
+}
