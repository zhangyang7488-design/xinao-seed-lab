+export function classifyProviderCapacityGate(env = process.env) {
+	if (env.PI_SUBAGENT_CHILD !== "1") return Object.freeze({ mode: "direct" });
+	const keys = [
+		CAPACITY_STATIC_ENV_KEY, CAPACITY_STATIC_SHA_ENV_KEY,
+		ROOT_BINDING_ENV_KEY, ROOT_BINDING_SHA_ENV_KEY,
+		CAPACITY_LAUNCH_TICKET_ENV_KEY, CAPACITY_LAUNCH_TICKET_SHA_ENV_KEY,
+	];
+	const present = keys.filter((key) => owns(env, key));
+	if (present.length === 0) return Object.freeze({ mode: "direct" });
+	if (present.length !== keys.length) fail("XINAO_PI_CAPACITY_HANDSHAKE_INCOMPLETE", "Capacity-bound child provider handshake is incomplete.");
+	const binding = parseRuntimeBinding(env);
+	const ticket = parseRuntimeTicket(env);
+	return Object.freeze({ mode: "gated", binding, ticket });
+}
+
+function createIsolatedHarness(options) {
+	const input = typeof options === "string" ? { registryRoot: options } : (options ?? {});
+	const registryRoot = path.resolve(requireString(input.registryRoot, "registryRoot"));
+	if (!/^D:\\/i.test(registryRoot)) fail("XINAO_PI_CAPACITY_PATH_INVALID", "Isolated capacity harness must use the local D: volume.");
+	TEST_REGISTRY_ROOTS.add(registryRoot.toLowerCase());
+	const staticPayload = { ...createStaticCapacityPayload(), registryRoot };
+	const staticEncoded = encodeCanonicalEnvPayload(staticPayload);
+	TEST_STATIC_REGISTRIES.set(staticEncoded.sha, Object.freeze({ raw: staticEncoded.raw, registryRoot }));
+	const makeRootEnv = () => {
+		const env = {
+			[CAPACITY_STATIC_ENV_KEY]: staticEncoded.raw,
+			[CAPACITY_STATIC_SHA_ENV_KEY]: staticEncoded.sha,
+		};
+		TEST_ENV_REGISTRIES.set(env, registryRoot);
+		return env;
+	};
+	let env = makeRootEnv();
+	let activation;
+	return Object.freeze({
+		registryRoot,
+		staticPayload: Object.freeze(staticPayload),
+		staticEncoded,
+		get env() { return env; },
+		get binding() { return activation?.binding; },
+		freshRootEnv() {
+			env = makeRootEnv();
+			return env;
+		},
+		async activate(activationInput) {
+			activation = await activateRootCapacity({ ...activationInput, env });
+			Object.assign(env, activation.envProjection);
+			return activation;
+		},
+		async inspect() { return inspectRootCapacityLedger({ env, binding: activation?.binding }); },
+		async reserve(input) { return reserveRootSpawnGroup({ ...input, env }); },
+		async markStopped() { return markRootCapacityStopped({ env, binding: activation?.binding }); },
+		async confirmTerminal() { return confirmRootCapacityStopTerminal({ env, binding: activation?.binding }); },
+		projectTicket(input) { return projectRootSpawnTicketEnv({ ...input, env }); },
+		childEnv(input) {
+			const child = { ...env, PI_SUBAGENT_CHILD: "1", ...projectRootSpawnTicketEnv({ ...input, env }) };
+			TEST_ENV_REGISTRIES.set(child, registryRoot);
+			return child;
+		},
+		registerEnv(candidate) {
+			TEST_ENV_REGISTRIES.set(candidate, registryRoot);
+			return candidate;
+		},
+	});
+}
