+export async function refundRootSpawnTicketBeforeSpawn(input = {}) {
+	const env = input.env ?? process.env;
+	const binding = resolveBindingInput(env, input.binding);
+	const ids = ticketIdentifiers(input, env);
+	return withLedgerWrite(binding, input.signal, (database) => {
+		validateMetaIdentity(metaRow(database), binding, { allowStopped: true });
+		const row = database.prepare("SELECT * FROM spawn_tickets WHERE ticket_id=? AND reservation_id=?").get(ids.ticketId, ids.reservationId);
+		if (!row) fail("XINAO_PI_CAPACITY_TICKET_UNKNOWN", "Spawn ticket is not present in the durable reservation ledger.");
+		if (row.state === "refunded") return Object.freeze({ refunded: true, idempotent: true });
+		if (row.state === "committed") return Object.freeze({ refunded: false, committed: true });
+		if (row.state === "claimed" && row.launch_key !== ids.launchKey) fail("XINAO_PI_CAPACITY_TICKET_REPLAY", "Only the claiming launch may refund a claimed pre-spawn ticket.");
+		database.prepare("UPDATE spawn_tickets SET state='refunded', launch_key=COALESCE(launch_key,?), updated_at=? WHERE ticket_id=?").run(ids.launchKey, Date.now(), ids.ticketId);
+		return Object.freeze({ refunded: true, idempotent: false });
+	});
+}
