+function resolveRecoveryInitialTurnBudget(
+	value: unknown,
+): { turnBudget?: ResolvedTurnBudget; error?: string } {
+	const label = "recoveryDescriptor.initialTurnBudget";
+	if (!value || typeof value !== "object" || Array.isArray(value)) {
+		return resolveTurnBudgetConfig(value, label);
+	}
+	const record = value as Record<string, unknown>;
+	const hasOutcome = Object.prototype.hasOwnProperty.call(record, "outcome");
+	const hasTurnCount = Object.prototype.hasOwnProperty.call(record, "turnCount");
+	if (!hasOutcome && !hasTurnCount) return resolveTurnBudgetConfig(value, label);
+
+	const legacyFields = new Set(["maxTurns", "graceTurns", "outcome", "turnCount"]);
+	const unknownField = Object.keys(record).find((key) => !legacyFields.has(key));
+	if (!hasOutcome || !hasTurnCount || Object.keys(record).length !== legacyFields.size || unknownField) {
+		return { error: `${label} legacy state must contain exactly maxTurns, graceTurns, outcome, and turnCount.` };
+	}
+	if (record.outcome !== "within-budget") {
+		return { error: `${label}.outcome must be 'within-budget' for a legacy initial state.` };
+	}
+	if (record.turnCount !== 0) {
+		return { error: `${label}.turnCount must be 0 for a legacy initial state.` };
+	}
+	return resolveTurnBudgetConfig(
+		{ maxTurns: record.maxTurns, graceTurns: record.graceTurns },
+		label,
+	);
+}
