+		database.prepare("UPDATE spawn_tickets SET state='committed', updated_at=? WHERE ticket_id=?").run(now, ids.ticketId);
+		database.prepare("UPDATE capacity_meta SET spawn_count=spawn_count+1, updated_at=? WHERE singleton=1").run(now);
+		return Object.freeze({ ...ids, state: "committed", idempotent: false });
+	});
+}
+
+export async function refundRootSpawnTicketBeforeSpawn(input = {}) {
