+
+function createLedgerSchema(database) {
+	database.exec(`
+		CREATE TABLE IF NOT EXISTS capacity_meta (
+			singleton INTEGER PRIMARY KEY CHECK (singleton = 1),
+			schema_version INTEGER NOT NULL,
+			root_key TEXT NOT NULL,
+			profile TEXT NOT NULL,
+			canonical_agent_dir TEXT NOT NULL,
+			canonical_session_file TEXT NOT NULL,
+			session_id TEXT NOT NULL,
+			policy_sha TEXT NOT NULL,
+			registry_root TEXT NOT NULL,
+			epoch INTEGER NOT NULL,
+			token TEXT NOT NULL,
+			spawn_count INTEGER NOT NULL,
+			stopped INTEGER NOT NULL,
+			terminal_confirmed INTEGER NOT NULL,
+			created_at INTEGER NOT NULL,
+			updated_at INTEGER NOT NULL
+		);
+		CREATE TABLE IF NOT EXISTS spawn_reservations (
+			reservation_id TEXT PRIMARY KEY,
+			root_key TEXT NOT NULL,
+			epoch INTEGER NOT NULL,
+			token TEXT NOT NULL,
+			requested_count INTEGER NOT NULL,
+			closed INTEGER NOT NULL DEFAULT 0,
+			created_at INTEGER NOT NULL,
+			updated_at INTEGER NOT NULL
+		);
+		CREATE TABLE IF NOT EXISTS spawn_tickets (
+			ticket_id TEXT PRIMARY KEY,
+			reservation_id TEXT NOT NULL REFERENCES spawn_reservations(reservation_id),
+			ordinal INTEGER NOT NULL,
+			state TEXT NOT NULL CHECK (state IN ('reserved','claimed','committed','refunded')),
+			launch_key TEXT,
+			created_at INTEGER NOT NULL,
+			updated_at INTEGER NOT NULL,
+			UNIQUE (reservation_id, ordinal)
+		);
+		CREATE INDEX IF NOT EXISTS spawn_tickets_state_idx ON spawn_tickets(state);
+	`);
+}
+
+function metaRow(database) {
+	return database.prepare("SELECT * FROM capacity_meta WHERE singleton = 1").get();
+}
+
+function validateMetaIdentity(row, binding, { allowStopped = true } = {}) {
+	if (!row || Number(row.schema_version) !== LEDGER_SCHEMA_VERSION) fail("XINAO_PI_CAPACITY_LEDGER_DRIFT", "Capacity ledger schema is missing or unsupported.");
+	const checks = [
+		["root_key", binding.rootKey], ["profile", binding.profile],
+		["canonical_agent_dir", binding.canonicalAgentDir],
+		["canonical_session_file", binding.canonicalSessionFile],
+		["session_id", binding.sessionId], ["policy_sha", binding.policySha],
+		["registry_root", binding.registryRoot], ["epoch", binding.epoch], ["token", binding.token],
+	];
+	for (const [column, expected] of checks) {
+		const actual = column === "epoch" ? Number(row[column]) : row[column];
+		const equal = column.startsWith("canonical_") || column === "registry_root"
+			? String(actual).toLowerCase() === String(expected).toLowerCase()
+			: actual === expected;
+		if (!equal) fail("XINAO_PI_CAPACITY_STALE_BINDING", `Capacity binding no longer matches durable ledger field '${column}'.`);
