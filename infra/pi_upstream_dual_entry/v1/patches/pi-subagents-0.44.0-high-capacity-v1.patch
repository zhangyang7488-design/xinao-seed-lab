+
+function assertBindingPayloadEqual(actual, expected) {
+	if (!expected) return;
+	for (const key of BINDING_KEYS) {
+		if (actual[key] !== expected[key]) fail("XINAO_PI_CAPACITY_BINDING_DRIFT", `Supplied binding field '${key}' differs from the canonical environment.`);
+	}
+}
+
+function resolveBindingInput(env, supplied) {
+	const binding = parseRuntimeBinding(env);
+	assertBindingPayloadEqual(binding, supplied);
+	return binding;
+}
