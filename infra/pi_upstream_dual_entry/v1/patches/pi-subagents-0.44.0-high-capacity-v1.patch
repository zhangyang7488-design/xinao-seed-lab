+	if (!fs.existsSync(filename)) return false;
+	const database = openDatabase(filename);
+	try {
+		database.exec("BEGIN EXCLUSIVE");
+		database.exec("ROLLBACK");
+		safeClose(database);
+		return false;
+	} catch (error) {
+		safeClose(database);
+		if (isBusy(error)) return true;
+		throw error;
+	}
+}
+
+function readAndValidateCurrent(binding, { allowStopped = false, requireActivation = true } = {}) {
+	if (requireActivation && !activationLeaseIsHeld(binding)) fail("XINAO_PI_CAPACITY_ROOT_INACTIVE", "No exclusive root activation lease owns this binding.");
+	const filename = ledgerFilename(binding);
+	if (!fs.existsSync(filename)) fail("XINAO_PI_CAPACITY_LEDGER_MISSING", "Capacity ledger does not exist for this root binding.");
+	const database = openDatabase(filename);
+	try {
+		const row = validateMetaIdentity(metaRow(database), binding, { allowStopped });
+		return ledgerSnapshot(database, row);
+	} finally {
+		safeClose(database);
+	}
+}
+
+function initializeSlotFile(binding, slot) {
+	const filename = providerSlotFilename(binding, slot);
+	const database = openDatabase(filename);
+	try {
+		database.exec("BEGIN EXCLUSIVE");
+		database.exec("CREATE TABLE IF NOT EXISTS slot_guard (singleton INTEGER PRIMARY KEY CHECK(singleton=1), schema_version INTEGER NOT NULL, root_key TEXT NOT NULL, slot INTEGER NOT NULL)");
+		database.prepare("INSERT OR IGNORE INTO slot_guard(singleton,schema_version,root_key,slot) VALUES(1,?,?,?)").run(LEDGER_SCHEMA_VERSION, binding.rootKey, slot);
+		const row = database.prepare("SELECT * FROM slot_guard WHERE singleton=1").get();
+		if (!row || Number(row.schema_version) !== LEDGER_SCHEMA_VERSION || row.root_key !== binding.rootKey || Number(row.slot) !== slot) {
+			fail("XINAO_PI_CAPACITY_SLOT_DRIFT", `Provider slot ${slot} metadata is invalid.`);
+		}
+		database.exec("COMMIT");
+	} catch (error) {
+		safeRollback(database);
+		throw error;
+	} finally {
+		safeClose(database);
+	}
+}
+
+function acquireAllSlotsForRotation(binding, count) {
+	const held = [];
+	try {
+		for (let slot = 0; slot < count; slot += 1) {
+			const database = openDatabase(providerSlotFilename(binding, slot));
+			try {
+				database.exec("BEGIN EXCLUSIVE");
+				held.push(database);
+			} catch (error) {
+				safeClose(database);
+				if (isBusy(error)) fail("XINAO_PI_CAPACITY_SLOTS_BUSY", "Stopped root cannot rotate while a provider slot remains held.", error);
+				throw error;
+			}
+		}
+		return () => {
+			for (const database of held.reverse()) { safeRollback(database); safeClose(database); }
+		};
+	} catch (error) {
+		for (const database of held.reverse()) { safeRollback(database); safeClose(database); }
+		throw error;
+	}
+}
+
+function makeBinding({ canonicalAgentDir, profile, canonicalSessionFile, sessionId, rootKey, epoch, token, policySha, registryRoot }) {
+	return Object.freeze({
+		schema: ROOT_BINDING_SCHEMA,
+		canonicalAgentDir,
+		profile,
+		canonicalSessionFile,
+		sessionId,
+		rootKey,
+		epoch,
+		token,
+		policySha,
+		registryRoot,
+	});
+}
+
+export async function activateRootCapacity({ env = process.env, agentDir, profile, sessionId, sessionFile, signal } = {}) {
