+	const script = `$ErrorActionPreference='Stop';$d=[System.IO.DriveInfo]::new('${escapedRoot}');[pscustomobject]@{DriveType=[int]$d.DriveType;DriveFormat=$d.DriveFormat;IsReady=$d.IsReady}|ConvertTo-Json -Compress`;
