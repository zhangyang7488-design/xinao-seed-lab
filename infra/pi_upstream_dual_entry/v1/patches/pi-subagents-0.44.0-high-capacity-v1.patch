+
+export async function assertCurrentRootBinding({ env = process.env, binding: supplied } = {}) {
+	const binding = resolveBindingInput(env, supplied);
+	readAndValidateCurrent(binding, { allowStopped: false, requireActivation: true });
+	return binding;
+}
+
+export async function inspectRootCapacityLedger({ env = process.env, binding: supplied } = {}) {
+	const binding = resolveBindingInput(env, supplied);
+	return readAndValidateCurrent(binding, { allowStopped: true, requireActivation: true });
+}
+
+export async function reserveRootSpawnGroup({ env = process.env, reservationId, count, signal } = {}) {
