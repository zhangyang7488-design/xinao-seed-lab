+	const reservationId = normalizeOpaqueId(input.reservationId ?? projected?.reservationId, "reservationId");
+	const ticketId = normalizeOpaqueId(input.ticketId ?? projected?.ticketId, "ticketId");
+	const launchKey = normalizeOpaqueId(input.launchKey ?? projected?.launchKey, "launchKey");
+	if (projected && (reservationId !== projected.reservationId || ticketId !== projected.ticketId || launchKey !== projected.launchKey)) {
