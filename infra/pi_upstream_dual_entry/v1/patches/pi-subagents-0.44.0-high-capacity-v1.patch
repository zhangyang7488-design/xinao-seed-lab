+		schemaVersion: Number(row.schema_version),
+		rootKey: row.root_key,
+		profile: row.profile,
+		epoch: Number(row.epoch),
+		token: row.token,
+		spawnCount: Number(row.spawn_count),
+		pendingSpawns: Number(pending?.count ?? 0),
+		stopped: Number(row.stopped) !== 0,
+		terminalConfirmed: Number(row.terminal_confirmed) !== 0,
+		updatedAt: Number(row.updated_at),
