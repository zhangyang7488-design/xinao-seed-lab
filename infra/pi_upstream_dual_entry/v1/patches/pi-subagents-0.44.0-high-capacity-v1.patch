+	return withLedgerWrite(binding, input.signal, (database) => {
+		validateMetaIdentity(metaRow(database), binding, { allowStopped: true });
+		const row = database.prepare("SELECT * FROM spawn_tickets WHERE ticket_id=? AND reservation_id=?").get(ids.ticketId, ids.reservationId);
+		if (!row) fail("XINAO_PI_CAPACITY_TICKET_UNKNOWN", "Spawn ticket is not present in the durable reservation ledger.");
+		if (row.state === "refunded") return Object.freeze({ refunded: true, idempotent: true });
+		if (row.state === "committed") return Object.freeze({ refunded: false, committed: true });
+		if (row.state === "claimed" && row.launch_key !== ids.launchKey) fail("XINAO_PI_CAPACITY_TICKET_REPLAY", "Only the claiming launch may refund a claimed pre-spawn ticket.");
+		database.prepare("UPDATE spawn_tickets SET state='refunded', launch_key=COALESCE(launch_key,?), updated_at=? WHERE ticket_id=?").run(ids.launchKey, Date.now(), ids.ticketId);
+		return Object.freeze({ refunded: true, idempotent: false });
+	});
+}
+
+export async function closeRootSpawnReservation({ env = process.env, reservationId, signal } = {}) {
+	const binding = resolveBindingInput(env);
+	const canonicalReservationId = normalizeOpaqueId(reservationId, "reservationId");
+	return withLedgerWrite(binding, signal, (database) => {
+		validateMetaIdentity(metaRow(database), binding, { allowStopped: true });
+		const reservation = database.prepare("SELECT * FROM spawn_reservations WHERE reservation_id=?").get(canonicalReservationId);
+		if (!reservation) fail("XINAO_PI_CAPACITY_RESERVATION_UNKNOWN", "Spawn reservation is not present in the durable ledger.");
+		const now = Date.now();
+		const result = database.prepare("UPDATE spawn_tickets SET state='refunded', updated_at=? WHERE reservation_id=? AND state='reserved'").run(now, canonicalReservationId);
+		database.prepare("UPDATE spawn_reservations SET closed=1, updated_at=? WHERE reservation_id=?").run(now, canonicalReservationId);
+		return Object.freeze({ reservationId: canonicalReservationId, refunded: Number(result.changes ?? 0) });
+	});
+}
+
+export async function markRootCapacityStopped({ env = process.env, binding: supplied, signal } = {}) {
+	const binding = resolveBindingInput(env, supplied);
+	return withLedgerWrite(binding, signal, (database) => {
+		validateMetaIdentity(metaRow(database), binding, { allowStopped: true });
+		database.prepare("UPDATE capacity_meta SET stopped=1, terminal_confirmed=0, updated_at=? WHERE singleton=1").run(Date.now());
+		return ledgerSnapshot(database);
+	});
+}
+
+export async function confirmRootCapacityStopTerminal({ env = process.env, binding: supplied, signal } = {}) {
+	const binding = resolveBindingInput(env, supplied);
+	return withLedgerWrite(binding, signal, (database) => {
+		const row = validateMetaIdentity(metaRow(database), binding, { allowStopped: true });
+		if (Number(row.stopped) !== 1) fail("XINAO_PI_CAPACITY_STOP_REQUIRED", "Terminal confirmation requires a prior explicit Stop mark.");
+		database.prepare("UPDATE capacity_meta SET terminal_confirmed=1, updated_at=? WHERE singleton=1").run(Date.now());
+		return ledgerSnapshot(database);
+	});
+}
+
+function tryAcquireProviderSlot(binding, slot) {
+	const filename = providerSlotFilename(binding, slot);
+	if (!fs.existsSync(filename)) fail("XINAO_PI_CAPACITY_SLOT_MISSING", `Provider slot ${slot} is missing.`);
+	const database = openDatabase(filename);
+	try {
+		database.exec("BEGIN EXCLUSIVE");
+		const row = database.prepare("SELECT * FROM slot_guard WHERE singleton=1").get();
+		if (!row || Number(row.schema_version) !== LEDGER_SCHEMA_VERSION || row.root_key !== binding.rootKey || Number(row.slot) !== slot) {
+			fail("XINAO_PI_CAPACITY_SLOT_DRIFT", `Provider slot ${slot} metadata is invalid.`);
+		}
+		let released = false;
+		return Object.freeze({
+			slot,
+			async release() {
+				if (released) return;
+				released = true;
+				try { database.exec("COMMIT"); } finally { safeClose(database); }
+			},
+		});
+	} catch (error) {
+		safeClose(database);
+		if (isBusy(error)) return null;
+		throw error;
+	}
+}
+
+export async function acquireProviderSlot({ env = process.env, binding: supplied, signal } = {}) {
+	assertNotAborted(signal);
+	const binding = resolveBindingInput(env, supplied);
+	const policy = parseRuntimeStatic(env);
+	const ticket = parseRuntimeTicket(env);
+	await assertCurrentRootBinding({ env, binding });
+	await claimRootSpawnTicket({ env, binding, reservationId: ticket.reservationId, ticketId: ticket.ticketId, launchKey: ticket.launchKey, signal });
+	await commitRootSpawnTicket({ env, binding, reservationId: ticket.reservationId, ticketId: ticket.ticketId, launchKey: ticket.launchKey, signal });
+	const start = Number.parseInt(ticket.ticketId.slice(0, 8), 16) % policy.maxConcurrentProviders;
+	for (;;) {
+		assertNotAborted(signal);
+		// A durable Stop or epoch rotation must cancel a queued provider even
+		// while all six slot files remain held; do not wait until a slot opens.
+		await assertCurrentRootBinding({ env, binding });
+		for (let offset = 0; offset < policy.maxConcurrentProviders; offset += 1) {
+			const slot = (start + offset) % policy.maxConcurrentProviders;
+			const lease = tryAcquireProviderSlot(binding, slot);
+			if (!lease) continue;
+			try {
+				await assertCurrentRootBinding({ env, binding });
+				assertNotAborted(signal);
+				return lease;
+			} catch (error) {
+				await lease.release();
+				throw error;
+			}
+		}
+		await retryDelay(signal);
+	}
+}
+
+export async function releaseProviderSlot(lease) {
+	return lease?.release?.();
+}
+
+export function assertLegacySpawnGrantDisabled() {
+	fail("XINAO_PI_CAPACITY_GRANT_DISABLED", "Legacy spawn-budget grants are disabled by the durable root-session capacity contract.");
+}
+
+export function classifyProviderCapacityGate(env = process.env) {
+	if (env.PI_SUBAGENT_CHILD !== "1") return Object.freeze({ mode: "direct" });
+	const keys = [
+		CAPACITY_STATIC_ENV_KEY, CAPACITY_STATIC_SHA_ENV_KEY,
+		ROOT_BINDING_ENV_KEY, ROOT_BINDING_SHA_ENV_KEY,
+		CAPACITY_LAUNCH_TICKET_ENV_KEY, CAPACITY_LAUNCH_TICKET_SHA_ENV_KEY,
+	];
+	const present = keys.filter((key) => owns(env, key));
+	if (present.length === 0) return Object.freeze({ mode: "direct" });
+	if (present.length !== keys.length) fail("XINAO_PI_CAPACITY_HANDSHAKE_INCOMPLETE", "Capacity-bound child provider handshake is incomplete.");
+	const binding = parseRuntimeBinding(env);
+	const ticket = parseRuntimeTicket(env);
+	return Object.freeze({ mode: "gated", binding, ticket });
+}
+
+function createIsolatedHarness(options) {
+	const input = typeof options === "string" ? { registryRoot: options } : (options ?? {});
+	const registryRoot = path.resolve(requireString(input.registryRoot, "registryRoot"));
+	if (!/^D:\\/i.test(registryRoot)) fail("XINAO_PI_CAPACITY_PATH_INVALID", "Isolated capacity harness must use the local D: volume.");
+	TEST_REGISTRY_ROOTS.add(registryRoot.toLowerCase());
+	const staticPayload = { ...createStaticCapacityPayload(), registryRoot };
+	const staticEncoded = encodeCanonicalEnvPayload(staticPayload);
+	TEST_STATIC_REGISTRIES.set(staticEncoded.sha, Object.freeze({ raw: staticEncoded.raw, registryRoot }));
+	const makeRootEnv = () => {
+		const env = {
+			[CAPACITY_STATIC_ENV_KEY]: staticEncoded.raw,
+			[CAPACITY_STATIC_SHA_ENV_KEY]: staticEncoded.sha,
+		};
+		TEST_ENV_REGISTRIES.set(env, registryRoot);
+		return env;
+	};
+	let env = makeRootEnv();
+	let activation;
+	return Object.freeze({
+		registryRoot,
+		staticPayload: Object.freeze(staticPayload),
+		staticEncoded,
+		get env() { return env; },
+		get binding() { return activation?.binding; },
+		freshRootEnv() {
+			env = makeRootEnv();
+			return env;
+		},
+		async activate(activationInput) {
+			activation = await activateRootCapacity({ ...activationInput, env });
+			Object.assign(env, activation.envProjection);
+			return activation;
+		},
+		async inspect() { return inspectRootCapacityLedger({ env, binding: activation?.binding }); },
+		async reserve(input) { return reserveRootSpawnGroup({ ...input, env }); },
+		async markStopped() { return markRootCapacityStopped({ env, binding: activation?.binding }); },
+		async confirmTerminal() { return confirmRootCapacityStopTerminal({ env, binding: activation?.binding }); },
+		projectTicket(input) { return projectRootSpawnTicketEnv({ ...input, env }); },
+		childEnv(input) {
+			const child = { ...env, PI_SUBAGENT_CHILD: "1", ...projectRootSpawnTicketEnv({ ...input, env }) };
+			TEST_ENV_REGISTRIES.set(child, registryRoot);
+			return child;
+		},
+		registerEnv(candidate) {
+			TEST_ENV_REGISTRIES.set(candidate, registryRoot);
+			return candidate;
+		},
+	});
+}
+
+export const __testing = Object.freeze({
+	computeRootKey,
+	normalizeOpaqueId,
+	parseStaticWithRegistry,
+	parseBindingWithRegistry,
+	parseTicketWithRegistry,
+	assertFixedNtfsVolumeFacts,
+	createIsolatedHarness,
+});
