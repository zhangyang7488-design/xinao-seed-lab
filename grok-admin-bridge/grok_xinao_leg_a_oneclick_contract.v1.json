  "rollback": {
    "removes": [
      "test_carrier_root",
      "fixture_public_dispatcher_state",
      "temp_sealed_context_under_carrier"
    ],
    "preserves": [
      "source_worktree",
      "live_C_projections",
      "live_D_projections_outside_test_carrier"
    ],
    "error_token_if_source_mutated": "XINAO_LEG_A_SOURCE_WORKTREE_MUTATED"
  },
  "test": {
    "script": "grok-admin-bridge/Test-XinaoLegAOneClickConsumer.ps1",
    "mode": "production_shape_bound_with_bounded_dispatcher_fixture",
    "binding_policy": {
      "default_binds_production_parameter_and_result_shape": true,
      "co_located_production_scripts_must_be_statically_bound": true,
      "fixture_only_false_green_forbidden": true,
      "public_dispatch": "bounded_fake_no_real_provider_call",
      "second_real_provider_call_forbidden_inside_this_package": true,
      "allow_missing_production_scripts_only_with_explicit_switch": true
    },
    "required_cases": [
      "production_parameter_shape_bound",
      "production_result_schema_bound",
      "production_fail_closed_tokens_bound",
      "happy_path_fresh_consumer",
      "no_prior_chat_or_manual_hashes",
      "selection_only_and_common_via_public_dispatcher",
      "selection_decision_pinning_when_available",
      "backend_linux_container_only",
      "sealed_ro_and_worktree_ro_default",
      "authorized_write_domain_only_when_explicit",
      "valid_selfcontained_clone_authorized_write",
      "broken_gitdir_fail_closed",
      "linked_worktree_authorized_write_fail_closed",
      "reinit_head_ancestry_fail_closed",
      "missing_public_dispatcher_fail_closed",
      "missing_context_field_fail_closed",
      "rules_drift_fail_closed",
      "stale_selection_fail_closed",
      "docker_cli_missing_fail_closed",
      "write_scope_ambiguous_fail_closed",
      "backend_rejected_fail_closed",
      "result_json_evidence_surface",
      "rollback_preserves_source_worktree"
    ]
  },
  "non_goals": [
    "real_second_provider_spend_inside_this_worker_package",
    "leg_b_temporal_handoff",
    "owner_adoption_or_parent_completion",
    "editing_live_C_or_D_projections",
    "announcing_parent_complete",
    "fixture_only_green_without_production_shape_binding"
  ],
  "evidence_roots_expected": {
    "pool_or_dispatch": "D:\\XINAO_RESEARCH_RUNTIME\\state\\grok_worker_pool",
    "oneclick_local_state": "D:\\XINAO_RESEARCH_RUNTIME\\state\\xinao_leg_a_oneclick",
    "test_carrier_only_for_this_package": true
  }
}
