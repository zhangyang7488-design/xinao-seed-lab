# XINAO dedicated researcher provider-egress CONNECT proxy.
# Default deny. No TLS interception. No Dify client_localnet catch-all.
# Domains are rendered from a sealed allowlist (may be empty => deny all public).

acl to_private_networks dst 0.0.0.0/8
acl to_private_networks dst 10.0.0.0/8
acl to_private_networks dst 100.64.0.0/10
acl to_private_networks dst 127.0.0.0/8
acl to_private_networks dst 169.254.0.0/16
acl to_private_networks dst 172.16.0.0/12
acl to_private_networks dst 192.168.0.0/16
acl to_private_networks dst 224.0.0.0/4
acl to_private_networks dst 240.0.0.0/4
acl to_private_networks dst ::/128
acl to_private_networks dst ::1/128
acl to_private_networks dst ::ffff:0:0/96
acl to_private_networks dst ::/96
acl to_private_networks dst fc00::/7
acl to_private_networks dst fe80::/10

acl SSL_ports port 443
acl Safe_ports port 443
acl CONNECT method CONNECT

# Deny raw IP literal CONNECT by default (IPv4 and bracketed IPv6 forms).
acl to_ipv4_literal dstdom_regex ^[0-9]{1,3}(\.[0-9]{1,3}){3}$
acl to_ipv6_literal dstdom_regex ^\[

# Rendered allowlist entries (one domain token each). Empty => no allow rule body.
${PROVIDER_DSTDOMAIN_ACL}

http_port ${HTTP_PORT}

http_access deny !Safe_ports
http_access deny !CONNECT
http_access deny CONNECT !SSL_ports
http_access deny to_private_networks
http_access deny to_ipv4_literal
http_access deny to_ipv6_literal
http_access allow provider_domains
http_access deny all

coredump_dir ${COREDUMP_DIR}

# No SSL bump / MITM.
# No cache_peer required for direct CONNECT tunneling of allowlisted destinations.
# Access log: do not put secrets in URLs; never log Authorization bodies.
logformat xinao_egress %ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %Sh/%<a %mt
access_log daemon:/var/log/squid/access.log xinao_egress
cache deny all
logfile_rotate 5

connect_timeout 30 seconds
request_timeout 2 minutes
read_timeout 2 minutes
client_lifetime 5 minutes
shutdown_lifetime 30 seconds
max_filedescriptors 65536
