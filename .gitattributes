# The imported projects contain byte-level supply-chain pins generated from LF source blobs.
# Force deterministic materialization on Windows so fresh main-repo checkouts preserve those pins.
projects/dual-brain-coordination/** text eol=lf
projects/xinao-market-lab/** text eol=lf

# Foundation authority manifests hash these exact source surfaces byte-for-byte.
xinao_discovery/src/xinao/__init__.py text eol=lf
xinao_discovery/src/xinao/canonical/** text eol=lf
xinao_discovery/src/xinao/foundation/** text eol=lf
xinao_discovery/src/xinao/contracts/** text eol=lf
xinao_discovery/src/xinao/lineage/** text eol=lf
services/__init__.py text eol=lf
services/agent_runtime/__init__.py text eol=lf
services/agent_runtime/foundation_continuous_workflow.py text eol=lf
services/agent_runtime/foundation_continuous_workflow_v2.py text eol=lf

# XINAO researcher identities hash these Python companions byte-for-byte, and
# the dedicated egress assets execute inside Linux containers.
skills/xinao/scripts/xinao.py text eol=lf
skills/xinao/scripts/xinao_runtime.py text eol=lf
docker/xinao-researcher-egress/** text eol=lf
# Researcher image build surfaces are content-addressed (entrypoint/dockerfile
# sha256). Without eol=lf, Windows core.autocrlf yields raw-byte hashes that
# diverge from Git blobs / Linux checkouts while `git status` stays clean.
docker/xinao-researcher/entrypoint.py text eol=lf
docker/xinao-researcher/Dockerfile text eol=lf
scripts/verify_f4_live_canary_pack.py text eol=lf
scripts/verify_f4_negative_companion_pack.py text eol=lf
scripts/verify_f4_portfolio_source_canary_pack.py text eol=lf
scripts/run_foundation_v2_f4_negative_companion.py text eol=lf

# Behavior replay fixtures carry byte-level digests and must survive fresh Windows checkouts.
evals/mature_capability_recall/** text eol=lf
evals/thin_localization/** text eol=lf

# F4 authority sources are content-addressed and must retain verified LF bytes.
docker/f4-verifier/*.json text eol=lf
scripts/run_f4_snapshot_stage0.py text eol=lf
scripts/verify_f4_live_canary_pack.py text eol=lf
