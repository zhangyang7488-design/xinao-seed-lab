{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xinao.provider_egress_engineering_canary_receipt.v1",
  "title": "XINAO provider egress engineering canary receipt (seal-eligible)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path_class",
    "status",
    "real_provider_call",
    "provider_effect_verified",
    "requested_model",
    "observed_backend_model",
    "stop_reason",
    "output_tokens",
    "usage_accounting_complete",
    "usage",
    "endpoint_host",
    "internal_network_id",
    "proxy_container_id",
    "proxy_image_id",
    "allowlist_sha256",
    "proxy_config_sha256",
    "canary_image_id",
    "internal_network_only",
    "auth_mounted_read_only",
    "auth_content_persisted",
    "raw_output_persisted",
    "research_invoked",
    "is_research_call",
    "scientific_research",
    "masquerades_as_research",
    "scientific_adoption",
    "science_restored",
    "parent_complete",
    "authority",
    "completion_claim_allowed",
    "secrets_present",
    "provider_egress_runtime_verified",
    "provider_egress_live_verified",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "xinao.provider_egress_engineering_canary_receipt.v1" },
    "path_class": { "const": "engineering_canary" },
    "status": { "const": "observed" },
    "real_provider_call": { "const": true },
    "provider_effect_verified": { "const": true },
    "requested_model": { "const": "grok-4.5" },
    "observed_backend_model": { "const": "grok-4.5-build" },
    "stop_reason": { "const": "EndTurn" },
    "output_tokens": { "type": "integer", "minimum": 1 },
    "usage_accounting_complete": { "const": true },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 1 },
        "total_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "endpoint_host": { "const": "cli-chat-proxy.grok.com" },
    "internal_network_id": { "type": "string", "minLength": 1 },
    "proxy_container_id": { "type": "string", "minLength": 1 },
    "proxy_image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "allowlist_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proxy_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canary_image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "internal_network_only": { "const": true },
    "auth_mounted_read_only": { "const": true },
    "auth_content_persisted": { "const": false },
    "raw_output_persisted": { "const": false },
    "research_invoked": { "const": false },
    "is_research_call": { "const": false },
    "scientific_research": { "const": false },
    "masquerades_as_research": { "const": false },
    "scientific_adoption": { "const": false },
    "science_restored": { "const": false },
    "parent_complete": { "const": false },
    "authority": { "const": false },
    "completion_claim_allowed": { "const": false },
    "secrets_present": { "const": false },
    "provider_egress_runtime_verified": { "const": false },
    "provider_egress_live_verified": { "const": false },
    "observed_at": { "type": "string", "pattern": "Z$" },
    "executed_at": { "type": "string", "pattern": "Z$" },
    "object_identities": { "type": "object" },
    "mode": { "type": "string" },
    "note": { "type": "string" },
    "docker_mutated": { "type": "boolean" },
    "carrier": { "type": "string" },
    "wsl_used": { "const": false },
    "git_bash_used": { "const": false },
    "probe_ok": { "type": "boolean" },
    "probe_exit_code": { "type": "integer" },
    "connect_probe_ok": { "type": "boolean" },
    "canary_container_id": { "type": "string" },
    "canary_container_removed": { "type": "boolean" },
    "endpoint_hint": { "type": "string" },
    "model_hint": { "type": "string" },
    "positive_token_present_observed": { "type": "boolean" },
    "positive_token_value": { "type": "null" },
    "engineering_evidence": { "type": "object" },
    "redaction": { "type": "object" },
    "allow_real_provider_call_requested": { "type": "boolean" },
    "raw_output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reason_code": { "type": "string" },
    "connect_only": { "const": false },
    "http_only": { "const": false }
  }
}
