{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xinao.provider_egress_negative_suite_receipt.v1",
  "title": "XINAO provider egress negative suite receipt (seal-eligible)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path_class",
    "status",
    "suite_passed",
    "all_cases_passed",
    "cases",
    "pass_count",
    "fail_count",
    "internal_network_id",
    "proxy_container_id",
    "proxy_image_id",
    "allowlist_sha256",
    "proxy_config_sha256",
    "unauthorized_domain_reachable",
    "direct_no_proxy_escape",
    "provider_egress_runtime_verified",
    "provider_egress_live_verified",
    "secrets_present",
    "completion_claim_allowed",
    "authority",
    "science_restored",
    "parent_complete",
    "scientific_research",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "xinao.provider_egress_negative_suite_receipt.v1" },
    "path_class": { "const": "negative_suite" },
    "status": { "const": "observed" },
    "suite_passed": { "const": true },
    "all_cases_passed": { "const": true },
    "cases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["id", "ok"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "N1", "N3", "N4", "N5", "N6", "N7", "N8", "N9",
              "N15", "N17", "N17b", "N17c", "N17d"
            ]
          },
          "ok": { "const": true },
          "title": { "type": "string" },
          "expect": { "type": "string" },
          "mode": { "type": "string" },
          "target": { "type": "string" },
          "got_signal": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pass_count": { "const": 13 },
    "fail_count": { "const": 0 },
    "internal_network_id": { "type": "string", "minLength": 1 },
    "proxy_container_id": { "type": "string", "minLength": 1 },
    "proxy_image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "allowlist_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proxy_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unauthorized_domain_reachable": { "const": false },
    "direct_no_proxy_escape": { "const": false },
    "provider_egress_runtime_verified": { "const": false },
    "provider_egress_live_verified": { "const": false },
    "secrets_present": { "const": false },
    "completion_claim_allowed": { "const": false },
    "authority": { "const": false },
    "science_restored": { "const": false },
    "parent_complete": { "const": false },
    "scientific_research": { "const": false },
    "observed_at": { "type": "string", "pattern": "Z$" },
    "executed_at": { "type": "string", "pattern": "Z$" },
    "object_identities": { "type": "object" },
    "mode": { "type": "string" },
    "note": { "type": "string" },
    "docker_mutated": { "type": "boolean" },
    "carrier": { "type": "string" },
    "wsl_used": { "const": false },
    "git_bash_used": { "const": false },
    "research_invoked": { "const": false }
  }
}
