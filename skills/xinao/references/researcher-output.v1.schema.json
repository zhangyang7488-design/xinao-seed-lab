{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_question",
    "summary",
    "hypotheses",
    "methods",
    "evidence_needed",
    "current_action_projection"
  ],
  "properties": {
    "schema_version": {"const": "xinao.research_candidate.v1"},
    "status": {"enum": ["CANDIDATE_READY", "EXPLICIT_NO_ACTION"]},
    "research_question": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string"}},
    "evidence_needed": {"type": "array", "items": {"type": "string"}},
    "current_action_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "family", "reason"],
      "properties": {
        "status": {"enum": ["SUPPORTED", "UNSUPPORTED", "NOT_ASSESSED"]},
        "family": {"type": ["string", "null"]},
        "reason": {"type": "string"}
      }
    }
  }
}
