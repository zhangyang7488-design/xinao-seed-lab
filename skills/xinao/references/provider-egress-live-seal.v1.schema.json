{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xinao.provider_egress_live_seal.v1",
  "title": "XINAO provider egress live seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_egress_live_verified",
    "posture_sha256",
    "posture_relative_path",
    "negative_suite_receipt_sha256",
    "negative_suite_receipt_relative_path",
    "positive_canary_receipt_sha256",
    "positive_canary_receipt_relative_path",
    "allowlist_sha256",
    "proxy_config_sha256",
    "proxy_container_id",
    "proxy_image_id",
    "internal_network_id",
    "internal_network_name",
    "external_network_name",
    "proxy_endpoint",
    "docker_engine_observational_id",
    "docker_server_version",
    "docker_ostype",
    "sealed_at",
    "expires_at",
    "completion_claim_allowed",
    "authority",
    "science_restored",
    "parent_complete",
    "secrets_present",
    "trust_boundary"
  ],
  "properties": {
    "schema_version": { "const": "xinao.provider_egress_live_seal.v1" },
    "provider_egress_live_verified": { "const": true },
    "posture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "posture_relative_path": { "const": "current_posture.v1.json" },
    "negative_suite_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "negative_suite_receipt_relative_path": { "type": "string", "minLength": 1 },
    "positive_canary_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positive_canary_receipt_relative_path": { "type": "string", "minLength": 1 },
    "allowlist_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proxy_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proxy_container_id": { "type": "string", "minLength": 1 },
    "proxy_image_id": { "type": "string", "pattern": "^sha256:" },
    "internal_network_id": { "type": "string", "minLength": 1 },
    "internal_network_name": { "const": "xinao_researcher_internal" },
    "external_network_name": { "type": "string", "minLength": 1 },
    "proxy_endpoint": { "const": "http://xinao-researcher-egress-proxy:3128" },
    "docker_engine_observational_id": { "type": "string", "minLength": 1 },
    "docker_server_version": { "type": "string", "minLength": 1 },
    "docker_ostype": { "const": "linux" },
    "sealed_at": { "type": "string", "pattern": "Z$" },
    "expires_at": { "type": "string", "pattern": "Z$" },
    "completion_claim_allowed": { "const": false },
    "authority": { "const": false },
    "science_restored": { "const": false },
    "parent_complete": { "const": false },
    "secrets_present": { "const": false },
    "trust_boundary": {
      "const": "host_filesystem_and_docker_cli_observation_only_no_signing_pki"
    }
  }
}
