{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_question",
    "as_of",
    "material_bundle_id",
    "material_refs_used",
    "summary",
    "hypotheses",
    "competing_explanations",
    "methods",
    "evidence_used",
    "counterevidence",
    "limitations",
    "next_evidence"
  ],
  "properties": {
    "schema_version": {"const": "xinao.research_candidate.v2"},
    "status": {"enum": ["CANDIDATE_READY", "INSUFFICIENT_EVIDENCE"]},
    "research_question": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "material_bundle_id": {
      "type": "string",
      "pattern": "^xinao-material-bundle-sha256:[0-9a-f]{64}$"
    },
    "material_refs_used": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "sha256"],
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "competing_explanations": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string"}},
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "finding", "locator"],
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "finding": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_evidence": {"type": "array", "items": {"type": "string"}},
    "account_identity": {
      "enum": ["ACTION", "RESEARCHER_ACCOUNT_NO_ACTION"]
    },
    "complete_actor_behavior_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authored_at",
        "decision_kind",
        "stake",
        "research_rationale"
      ],
      "properties": {
        "schema_version": {"const": "xinao.actor_authored_behavior_intent.v1"},
        "authored_at": {"type": "string", "minLength": 1},
        "decision_kind": {"enum": ["ACTION", "NO_ACTION"]},
        "panel": {"enum": ["A", "B", null]},
        "selected_number": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 49
        },
        "stake": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"},
        "research_rationale": {"type": "string", "minLength": 1},
        "after_hit_response": {"type": ["string", "null"], "minLength": 1},
        "after_miss_response": {"type": ["string", "null"], "minLength": 1},
        "next_round_or_stop_response": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision_kind": {"const": "ACTION"}}},
          "then": {
            "required": ["panel", "selected_number"],
            "properties": {
              "panel": {"enum": ["A", "B"]},
              "selected_number": {"type": "integer", "minimum": 1, "maximum": 49},
              "stake": {
                "type": "string",
                "pattern": "^(?!0\\.0000$)(0|[1-9][0-9]*)\\.[0-9]{4}$"
              }
            }
          },
          "else": {
            "properties": {
              "panel": {"type": "null"},
              "selected_number": {"type": "null"},
              "stake": {"const": "0.0000"}
            }
          }
        }
      ]
    },
    "executable_account_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "selected_number",
        "stake",
        "target_ref",
        "target_open_time",
        "freeze_deadline",
        "knowledge_cutoff",
        "odds_version_ref",
        "baseline_ref",
        "risk_policy_ref",
        "rule_ref"
      ],
      "properties": {
        "panel": {"enum": ["A", "B"]},
        "selected_number": {"type": "integer", "minimum": 1, "maximum": 49},
        "stake": {
          "type": "string",
          "pattern": "^(?!0\\.0000$)(0|[1-9][0-9]*)\\.[0-9]{4}$"
        },
        "target_ref": {"type": "string", "minLength": 1},
        "target_open_time": {"type": "string", "minLength": 1},
        "freeze_deadline": {"type": "string", "minLength": 1},
        "knowledge_cutoff": {"type": "string", "minLength": 1},
        "odds_version_ref": {"type": "string", "minLength": 1},
        "baseline_ref": {"enum": ["BO0001", "BO0013"]},
        "risk_policy_ref": {"type": "string", "minLength": 1},
        "rule_ref": {"const": "special-number-rule.v1"}
      }
    },
    "no_action_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "target_open_time",
        "freeze_deadline",
        "knowledge_cutoff",
        "odds_version_ref",
        "rule_ref"
      ],
      "properties": {
        "target_ref": {"type": "string", "minLength": 1},
        "target_open_time": {"type": "string", "minLength": 1},
        "freeze_deadline": {"type": "string", "minLength": 1},
        "knowledge_cutoff": {"type": "string", "minLength": 1},
        "odds_version_ref": {"type": "string", "minLength": 1},
        "rule_ref": {"const": "special-number-rule.v1"}
      }
    }
  },
  "oneOf": [
    {
      "required": ["status"],
      "properties": {"status": {"const": "CANDIDATE_READY"}},
      "not": {
        "anyOf": [
          {"required": ["account_identity"]},
          {"required": ["complete_actor_behavior_intent"]},
          {"required": ["executable_account_decision"]},
          {"required": ["no_action_intent"]}
        ]
      }
    },
    {
      "required": ["status", "complete_actor_behavior_intent"],
      "properties": {"status": {"const": "CANDIDATE_READY"}},
      "not": {
        "anyOf": [
          {"required": ["account_identity"]},
          {"required": ["executable_account_decision"]},
          {"required": ["no_action_intent"]}
        ]
      }
    },
    {
      "required": ["status", "executable_account_decision"],
      "properties": {
        "status": {"const": "CANDIDATE_READY"},
        "account_identity": {"const": "ACTION"}
      },
      "not": {"required": ["no_action_intent"]}
    },
    {
      "required": ["status", "no_action_intent"],
      "properties": {
        "status": {"const": "CANDIDATE_READY"},
        "account_identity": {"const": "RESEARCHER_ACCOUNT_NO_ACTION"}
      },
      "not": {"required": ["executable_account_decision"]}
    },
    {
      "required": ["status"],
      "properties": {"status": {"const": "INSUFFICIENT_EVIDENCE"}},
      "not": {
        "anyOf": [
          {"required": ["account_identity"]},
          {"required": ["complete_actor_behavior_intent"]},
          {"required": ["executable_account_decision"]},
          {"required": ["no_action_intent"]}
        ]
      }
    }
  ]
}
